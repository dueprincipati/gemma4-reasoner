# Backend: ollama | huggingface | openai_compat
BACKEND=ollama

# Ollama settings
OLLAMA_BASE_URL=http://localhost:11434

# Model: e2b | e4b | 26b | 31b
MODEL_SIZE=e4b

# Thinking mode (chain-of-thought)
THINKING=true

# Sampling
TEMPERATURE=1.0
TOP_P=0.95
TOP_K=64
MAX_TOKENS=8192

# Image token budget: 70 | 140 | 280 | 560 | 1120
IMAGE_TOKEN_BUDGET=560

# OpenAI-compatible API key (if using openai_compat backend)
OPENAI_API_KEY=dummy
OPENAI_BASE_URL=http://localhost:8000/v1
